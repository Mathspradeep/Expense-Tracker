{
  "id": "/",
  "name": "RupeeTrack - Expense & Wealth Tracker",
  "short_name": "RupeeTrack",
  "description": "Comprehensive Indian Expense, Income, and Savings Tracker Progressive Web App",
  "start_url": "/",
  "scope": "/",
  "lang": "en-IN",
  "dir": "ltr",
  "orientation": "any",
  "display": "standalone",
  "display_override": [
    "tabbed",
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#0f172a",
  "theme_color": "#4f46e5",
  "categories": [
    "finance",
    "productivity",
    "utilities"
  ],
  "iarc_rating_id": "e84b3e5d-2e23-4f11-a980-14145937a00e",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.rupeetrack.app",
      "id": "com.rupeetrack.app"
    }
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add Transaction",
      "short_name": "Add",
      "description": "Quickly record a new income or expense item",
      "url": "/?action=add",
      "icons": [
        {
          "src": "/shortcut-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Desktop Dashboard"
    },
    {
      "src": "/screenshot-mobile.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Mobile Transaction Overview"
    }
  ],
  "widgets": [
    {
      "name": "RupeeTrack Summary",
      "short_name": "Summary",
      "description": "Widget for quick balance overview",
      "tag": "rupeetrack-summary",
      "template": "widget-template",
      "ms_ac_template": "/widgets/summary.json",
      "data": "/widgets/data.json",
      "type": "text/html",
      "screenshots": [
        {
          "src": "/icon-512.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ],
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "note_taking": {
    "new_note_url": "/?action=new-note"
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/csv": [".csv"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+rupeetrack",
      "url": "/?data=%s"
    }
  ],
  "share_target": {
    "action": "/import-csv",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "text/csv",
            ".csv"
          ]
        }
      ]
    }
  },
  "scope_extensions": [
    {
      "origin": "https://rupeetrack.app"
    },
    {
      "origin": "*.rupeetrack.app"
    }
  ]
}
